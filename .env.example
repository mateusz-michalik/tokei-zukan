# Optional. Nothing here is needed to build, run or test Tokei Zukan; leave it all unset.

# Cloudflare Web Analytics, production only (see docs/analytics.md). Set these in Vercel's
# Production environment, not Preview. The token is the public site token from Cloudflare's
# "Manage site" snippet, not an account or API secret.
VITE_CF_ANALYTICS_TOKEN=
VITE_ANALYTICS_HOST=
