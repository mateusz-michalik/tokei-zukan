{
  "name": "tokei-zukan",
  "private": true,
  "version": "0.2.0",
  "description": "Explore watches, compare their sizes to scale and see how they wear on your wrist.",
  "license": "MIT",
  "author": "Mateusz Michalik",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateusz-michalik/tokei-zukan.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build && node scripts/share-previews.mjs",
    "preview": "vite preview",
    "share:review": "npm run build && node scripts/share-review.mjs && vite preview --open /share-review.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/arimo": "^0.4.3",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
