<script>
  // Apply the saved theme before first paint so dark mode doesn't flash light. The app keeps it in step afterwards.
  // Pages are light unless the visitor chose dark, or chose to match a device that's in dark mode.
  document.documentElement.dataset.theme = 'light';
  try {
    const saved = JSON.parse(localStorage.getItem('wristcheck.v2') || '{}') || {};
    // A `system` saved before light became the default (no themeVersion) was that default, not a choice.
    const t = saved.theme === 'system' && saved.themeVersion !== 2 ? 'light' : saved.theme;
    const dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
  } catch {}
</script>
